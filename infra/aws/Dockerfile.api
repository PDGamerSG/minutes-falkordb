# Minutes API for the AWS Compose stack (FalkorDB runs in its own container).
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.11.32 /uv /usr/local/bin/uv

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY packages ./packages
COPY apps/api ./apps/api
COPY cypher ./cypher
RUN uv sync --frozen --no-dev --package minutes-api
COPY data ./data
COPY docs/bench ./docs/bench
COPY infra/aws/api-start.sh /app/api-start.sh

RUN useradd --system --uid 10001 --home-dir /app --shell /usr/sbin/nologin minutes \
 && chmod +x /app/api-start.sh && chown -R minutes:minutes /app
USER minutes

ENV PATH=/app/.venv/bin:$PATH \
    PORT=8000
EXPOSE 8000
CMD ["/app/api-start.sh"]
