# FalkorDB (pinned 6.0.x; validated on 6.0.1)
FALKORDB_URL=falkor://localhost:6379
FALKORDB_ADMIN_USER=
FALKORDB_ADMIN_PASSWORD=
TENANT_RW_PASSWORD=change-me-rw
TENANT_RO_PASSWORD=change-me-ro

# LLM: gemini | openrouter | ollama
LLM_BACKEND=ollama
LLM_MODEL=gemma4:e4b
LLM_MODEL_SMALL=gemma4:e4b
GEMINI_API_KEY=
GEMINI_API_KEY_2=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Embeddings: onnx | gemini | fake
EMBED_BACKEND=onnx
EMBED_MODEL=onnx-community/embeddinggemma-300m-ONNX
HF_HOME=D:\hf-cache

# API
API_HOST=0.0.0.0
API_PORT=8080
CORS_ORIGINS=http://localhost:3001

# Web
NEXT_PUBLIC_API_URL=http://localhost:8080
