# FalkorDB (pinned 6.0.x; validated on 6.0.1)
FALKORDB_URL=falkor://localhost:6379
FALKORDB_ADMIN_USER=
FALKORDB_ADMIN_PASSWORD=
# Passwords for the per-tenant ACL users. Change both for any non-local deployment.
TENANT_RW_PASSWORD=change-me-rw
TENANT_RO_PASSWORD=change-me-ro

# ---- Deployment profile -------------------------------------------------------------------------
# ENV=production: AUTO_CREATE_TENANTS defaults to false, CORS trusts CORS_ORIGINS and CORS_ORIGIN_REGEX only (no localhost regex),
# and the API warns at startup when ADMIN_TOKEN is empty.
ENV=development
# Create the SEED_TENANTS graphs on boot when missing (default: true in development, false in production).
# AUTO_CREATE_TENANTS=
SEED_TENANTS=orbit,nimbus,quill

# ---- Authentication -----------------------------------------------------------------------------
# Admin token: required (Authorization: Bearer <token> or X-Admin-Token) on POST/DELETE /tenants,
# POST /tenants/{t}/rotate-key, /tenants/{t}/demo/*, POST /bench/run, POST /tenants/{t}/snapshots and
# POST /tenants/{t}/work-items/import. Empty = those routes are open (local development only).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# true = every /tenants/{t}/... route needs the tenant's key in X-API-Key (EventSource and <audio> may use
# ?api_key=). Keys are created with the tenant, shown once and stored hashed; the admin token also works.
TENANT_KEYS_REQUIRED=false

# ---- LLM: gemini | openrouter | ollama | fake ---------------------------------------------------
LLM_BACKEND=ollama
LLM_MODEL=gemma4:e4b
LLM_MODEL_SMALL=gemma4:e4b
GEMINI_API_KEY=
GEMINI_API_KEY_2=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_MAX_TOKENS=1024
# Per HTTP call. Keep it at 60 or below on a hosted deployment.
LLM_TIMEOUT_S=180
# Process-wide input-token budget per minute shared by every Gemini call (chars/4). Requests queue up to
# 20 s for budget, then fail with 503 llm_rate_limited and a Retry-After header. The free tier is 16000.
GEMINI_TPM_BUDGET=14000
# Wall-clock limit for one agent task (the tool loop); the task fails with "deadline exceeded" past it.
AGENT_TASK_DEADLINE_S=300

# ---- Embeddings: onnx | gemini | fake ------------------------------------------------------------
EMBED_BACKEND=onnx
EMBED_MODEL=onnx-community/embeddinggemma-300m-ONNX
# Model cache directory; leave empty for the platform default. The Docker image bakes the model into
# /app/hf-cache and sets HF_HUB_OFFLINE=1. A tenant remembers which model embedded it
# (tenant meta embedding_model / embedding_dim); a different model is refused (409 on import, 503 on /health).
HF_HOME=

# ---- API ------------------------------------------------------------------------------------------
# Comma-separated browser origins. In production this list and CORS_ORIGIN_REGEX are the only CORS allowance.
CORS_ORIGINS=http://localhost:3001
# Optional regex of extra trusted origins, e.g. every Vercel deployment URL of one project.
CORS_ORIGIN_REGEX=
DATA_DIR=data
BENCH_RESULTS_DIR=docs/bench
# Import body limit in bytes (meetings and email); larger bodies are refused with 413 before parsing.
MAX_IMPORT_BYTES=10485760
# Snapshots per tenant; the next one is refused with 409 snapshot_quota.
MAX_SNAPSHOTS_PER_TENANT=10
# true = /health also fails when the model is unreachable or an agent worker has died.
STRICT_HEALTH=false
# fact.superseded events whose new valid_from is older than this are historical imports and do not wake the Scheduler.
LIVE_EVENT_MAX_AGE_DAYS=14
# Seconds between database reconnect attempts while FalkorDB is unreachable at boot (/health answers 503 meanwhile).
STARTUP_RETRY_S=15
LOG_LEVEL=INFO
# Set to 'fake' to run the API entirely in memory (no FalkorDB); tests and offline demos.
# HIVE_BACKEND=

# ---- Workers --------------------------------------------------------------------------------------
# WORKERS_ENABLED=false on small plans (about 15 coroutines plus the ONNX model need roughly 1 GB).
WORKERS_ENABLED=true
# Fallback poll; workers wake immediately on task.submitted / task.handed_off / task.lease_expired events.
WORKER_POLL_S=15
# Agent.last_seen is written at most this often.
WORKER_TOUCH_S=30
# A claimed task carries a lease; the running worker extends it every WORKER_HEARTBEAT_S and a reaper
# (every REAPER_INTERVAL_S) returns tasks whose lease lapsed to submitted.
TASK_LEASE_MS=120000
WORKER_HEARTBEAT_S=30
REAPER_INTERVAL_S=30
STANDUP_MIN_MEETINGS=2

# ---- Tickets (FollowUpAgent): leave both empty for simulated issues (minutes://simulated/issue/<id>) ----
GITHUB_TOKEN=
GITHUB_DEMO_REPO=

# ---- Web ------------------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
