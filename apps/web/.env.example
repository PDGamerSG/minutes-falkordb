# Base URL of apps/api (FastAPI). Inlined at build time.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Tenant API key sent as X-API-Key (and ?api_key= for the event stream and audio), needed when the API runs with
# TENANT_KEYS_REQUIRED=true. Anything NEXT_PUBLIC_* is readable by every visitor of the site: use it only for a
# public single-tenant demo with synthetic data. Otherwise leave it unset and store a key in the browser instead:
#   localStorage.setItem("minutes.apiKey", "<key>")
# The admin token (demo buttons, snapshots, tenant creation) is never baked into the build; an operator stores it with
#   localStorage.setItem("minutes.adminToken", "<ADMIN_TOKEN>")
# NEXT_PUBLIC_API_KEY=

# Set to 1 to force mock data even when the API is reachable (demos, screenshots).
# NEXT_PUBLIC_MOCK=1
